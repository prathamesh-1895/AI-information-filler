{
  "$comment": "Rule-based field mapping (PLAYBOOK Task 5.1). Patterns are regular expressions matched as whole words against normalised text (lowercase, punctuation folded to spaces). 'patterns' are enough on their own; 'contextPatterns' only count when the label or section heading names the key's list group (education, experience, projects, languages, certifications). Every canonical key must appear exactly once.",
  "version": 1,
  "groupContext": {
    "education": "education|educational|academic|academics|qualification|qualifications|college|university|school|degree|graduation|class 1[02]|ssc|hsc",
    "experience": "experience|employment|work|job|career|professional history|internship|employer",
    "projects": "projects?",
    "certifications": "certifications?|certificates?|licen[cs]es?",
    "languages": "languages?"
  },
  "entries": [
    {
      "key": "person.name.full",
      "patterns": [
        "full name",
        "your name",
        "name",
        "applicant name",
        "applicant s name",
        "candidate name",
        "candidate s name",
        "name of (the )?(applicant|candidate|student)",
        "student name",
        "legal name",
        "name as per .*"
      ]
    },
    {
      "key": "person.name.first",
      "patterns": ["first name", "given name", "forename", "fname", "first"]
    },
    {
      "key": "person.name.middle",
      "patterns": ["middle name", "middle initial", "mname"]
    },
    {
      "key": "person.name.last",
      "patterns": ["last name", "surname", "family name", "lname", "last"]
    },
    {
      "key": "person.name.display",
      "patterns": [
        "display name",
        "public name",
        "screen name",
        "user ?name",
        "nick ?name",
        "profile name"
      ]
    },
    {
      "key": "person.dob",
      "patterns": ["date of birth", "dob", "birth ?date", "birthday", "d o b"]
    },
    {
      "key": "person.gender",
      "patterns": ["gender", "sex"]
    },
    {
      "key": "person.nationality",
      "patterns": ["nationality", "citizenship", "citizen of"]
    },
    {
      "key": "family.father_name",
      "patterns": [
        "fathers? name",
        "father name",
        "name of (the )?father",
        "fathers? full name",
        "guardian s name"
      ]
    },
    {
      "key": "family.mother_name",
      "patterns": ["mothers? name", "mother name", "name of (the )?mother", "mothers? full name"]
    },
    {
      "key": "contact.email",
      "patterns": [
        "e ?mail",
        "e ?mail address",
        "e ?mail id",
        "mail id",
        "email address",
        "your email",
        "work email",
        "personal email"
      ]
    },
    {
      "key": "contact.email_alt",
      "patterns": ["(alternate|alternative|secondary|other|backup) e ?mail( address| id)?"]
    },
    {
      "key": "contact.phone.mobile",
      "patterns": [
        "mobile",
        "mobile (no|number|phone)",
        "phone",
        "phone (no|number)",
        "contact (no|number)",
        "cell( phone)?",
        "telephone",
        "tel",
        "primary (phone|mobile)"
      ]
    },
    {
      "key": "contact.phone.alt",
      "patterns": [
        "(alternate|alternative|secondary|other|emergency) (phone|mobile|contact)( no| number)?",
        "landline",
        "alt phone"
      ]
    },
    {
      "key": "contact.whatsapp",
      "patterns": ["whats ?app( no| number)?"]
    },
    {
      "key": "address.line1",
