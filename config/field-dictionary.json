    {
      "key": "education[].start",
      "patterns": ["year of (joining|admission)", "admission year"],
      "contextPatterns": ["start( date| month| year)?", "from", "joined", "start"]
    },
    {
      "key": "education[].end",
      "patterns": [
        "graduation (year|month|date)",
