{
  "name": "filler",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @filler/extension dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:install": "node scripts/playwright.mjs install chromium",
    "e2e:headed": "node scripts/e2e.mjs --headed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@filler/core": "workspace:^",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
